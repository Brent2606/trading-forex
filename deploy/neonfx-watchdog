#!/bin/sh
# Restart the NEONFX bot when Docker marks it unhealthy or it is not running.
s=$(docker inspect -f "{{.State.Health.Status}}" neonfx-bot 2>/dev/null || echo missing)
if [ "$s" = "unhealthy" ] || [ "$s" = "missing" ]; then
  logger -t neonfx-watchdog "bot status $s, restarting"
  cd /opt/neonfx && docker compose up -d >/dev/null 2>&1 && docker restart neonfx-bot >/dev/null 2>&1
fi
