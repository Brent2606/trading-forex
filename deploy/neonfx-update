#!/bin/sh
# Updates the bot on the server from GitHub (main), rebuilds it and restarts it.
# Data (data/), secrets (.env) and the downloaded history are not touched.
set -e
cd /opt/neonfx
git fetch -q origin main
git reset -q --hard origin/main
docker run --rm -v /opt/neonfx:/app -w /app node:22-alpine sh -c "npm ci --silent && npm run -s bot:build"
install -m 755 deploy/neonfx-watchdog deploy/neonfx-backup deploy/neonfx-history deploy/neonfx-update /usr/local/bin/
install -m 700 deploy/neonfx-set-oanda deploy/neonfx-set-ctrader /usr/local/bin/
install -m 644 deploy/cron.neonfx /etc/cron.d/neonfx
docker compose up -d --build
echo "NEONFX updated to $(git log --oneline -1)"
