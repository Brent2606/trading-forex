{
  "name": "neonfx-terminal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NEONFX: a neon forex paper-trading terminal with simulated live feed, charting, risk management, backtesting and analytics.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.2"
  }
}
